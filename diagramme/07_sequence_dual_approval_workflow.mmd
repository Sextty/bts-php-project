sequenceDiagram
    autonumber

    box rgb(255, 243, 224) Actors
        actor Staff as "Agent Staff (Agence)"
        actor Admin as "Direction / Admin"
        actor Client as "Client"
    end

    box rgb(232, 245, 233) Backend Services
        participant API as "Laravel Backend API"
        participant ReviewSvc as "CreditApplicationReviewService"
        participant ApptSvc as "AppointmentSchedulingService"
        participant DB as "MySQL Database"
    end

    box rgb(224, 242, 241) Real-Time
        participant Reverb as "Laravel Reverb (WebSockets)"
    end

    %% Flow 1: Staff L1 Review
    rect rgb(235, 245, 255)
        Note over Staff, DB: Flow 1: Staff L1 Review (Agence Locale)
        Staff->>API: GET /api/staff/applications/{id}
        API->>DB: Load complete dossier + docs + Google Gemini analysis
        DB-->>API: Dossier details, documents & AI analysis results
        API-->>Staff: Dossier details & AI recommendations

        Staff->>API: POST /api/staff/applications/{id}/review { decision: 'STAFF_APPROVED', notes }
        API->>ReviewSvc: handleStaffDecision(application, decision, notes)
        ReviewSvc->>DB: UPDATE status='STAFF_APPROVED', staff_reviewed_by, staff_reviewed_at
        ReviewSvc->>DB: Log in audit_logs ('STAFF_APPROVED')
        ReviewSvc->>Reverb: Broadcast notification ('STAFF_APPROVAL_COMPLETED')
        API-->>Staff: HTTP 200 { message: 'Transmis a la direction' }
    end

    %% Flow 2: Admin L2 Final Decision
    rect rgb(255, 248, 225)
        Note over Admin, DB: Flow 2: Admin L2 Final Decision & Automatic Scheduling
        Admin->>API: GET /api/admin/applications/pending
        API->>DB: Query dossiers WHERE status='STAFF_APPROVED'
        DB-->>API: List of staff-approved dossiers
        API-->>Admin: List of staff-approved dossiers

        Admin->>API: POST /api/staff/applications/{id}/final-approval { decision: 'APPROVED' }
        API->>ReviewSvc: handleAdminDecision(application, 'APPROVED')
        ReviewSvc->>DB: UPDATE status='ADMIN_APPROVED', admin_reviewed_by, admin_reviewed_at
        ReviewSvc->>DB: Log in audit_logs ('ADMIN_APPROVED')

        ReviewSvc->>ApptSvc: proposeBranchAppointment(application)
        ApptSvc->>DB: Find available slot
        DB-->>ApptSvc: Available slot (Date: +3 days, Branch ID)
        ApptSvc->>DB: INSERT appointment (status: 'PROPOSED', date: '+3 days')
        ApptSvc->>DB: INSERT notification (user_id, 'Credit approuve')
        ApptSvc->>Reverb: Broadcast appointment event ('APPOINTMENT_PROPOSED')
        API-->>Admin: HTTP 200 { status: 'APPROVED', appointment_created: true }
    end

    %% Flow 3: Client Appointment Confirmation
    rect rgb(232, 245, 233)
        Note over Client, DB: Flow 3: Client Appointment Confirmation
        Reverb-->>Client: Real-time notification 'Credit approuve !'
        Client->>API: GET /api/applications/{id}/appointment
        API->>DB: Query appointment details
        DB-->>API: Proposed appointment slot
        API-->>Client: Proposed slot details (branch, date, hours)

        Client->>API: POST /api/applications/{id}/appointment/confirm
        API->>DB: UPDATE appointment SET status='CONFIRMED'
        API-->>Client: HTTP 200 { status: 'CONFIRMED' }
    end
