%%{init: {'theme':'base','themeVariables':{'fontFamily':'Arial, sans-serif','fontSize':'15px','primaryTextColor':'#0F172A','lineColor':'#475569'}}}%%
flowchart TB
    subgraph ACTEURS["Acteurs"]
        direction LR
        CLIENT["Client"]:::actor
        STAFF["Agent d'agence"]:::actor
        ADMIN["Administrateur"]:::actor
        SEC["Operateur securite"]:::actor
    end

    subgraph PORTAILS["Portails Next.js 16 / React 19"]
        direction LR
        PC["Client :3000<br/>Authentification, dossier, RDV, messagerie"]:::portal
        PS["Staff :3001<br/>Instruction agence, rapports, analytics"]:::portal
        PA["Admin :3002<br/>Decision finale, pilotage, osquery"]:::portal
        PSC["Security Center :3003<br/>Audit, suspensions, telemetrie"]:::security
    end

    subgraph API["Monolithe modulaire Laravel 12 - API JSON :8000"]
        direction LR
        GATE["Sanctum<br/>roles, permissions, policies<br/>rate limits, CORS, security headers"]:::gateway
        AUTH["Identite<br/>mot de passe, OTP, Google"]:::service
        CREDIT["Demandes de credit<br/>etats, validations, decisions"]:::service
        DOCS["Documents<br/>stockage prive, ClamAV, IA consultative"]:::service
        OPS["RDV, rapports<br/>notifications, analytics"]:::service
        BANK["Pilote ledger<br/>comptes, ecritures, maker-checker"]:::pilot
        SCAPI["Securite<br/>audit, osquery, telemetrie"]:::security
    end

    subgraph ASYNC["Traitements asynchrones et temps reel"]
        OUTBOX["Outbox transactionnelle<br/>queue base de donnees"]:::async
        WORKER["Workers + scheduler"]:::async
        REVERB["Laravel Reverb<br/>canaux prives"]:::async
    end

    subgraph DATA["Persistance"]
        DB[("MariaDB<br/>source transactionnelle")]:::data
        FILES["Stockage documentaire prive<br/>local ou S3-compatible"]:::data
    end

    subgraph EXT["Dependances optionnelles"]
        GOOGLE["Google OAuth"]:::external
        GEMINI["Gemini<br/>analyse documentaire consultative"]:::external
        CLAM["ClamAV"]:::external
        MSG["E-mail / SMS"]:::external
        OSQ["osquery / outils hote"]:::external
    end

    CLIENT --> PC
    STAFF --> PS
    ADMIN --> PA
    SEC --> PSC
    PC --> GATE
    PS --> GATE
    PA --> GATE
    PSC --> GATE
    GATE --> AUTH & CREDIT & DOCS & OPS & BANK & SCAPI
    AUTH --> GOOGLE & MSG
    DOCS --> FILES
    DOCS --> CLAM & GEMINI
    SCAPI --> OSQ
    AUTH --> DB
    CREDIT --> DB
    OPS --> DB
    BANK --> DB
    SCAPI --> DB
    OPS --> OUTBOX
    CREDIT --> OUTBOX
    OUTBOX --> WORKER
    WORKER --> DB & REVERB & MSG
    PC <--> REVERB
    PS <--> REVERB
    PA <--> REVERB

