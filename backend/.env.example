APP_NAME="BTS Bank Credit"
APP_ENV=local
APP_KEY=
AUDIT_HMAC_KEY=
AUDIT_HMAC_KEY_VERSION=v1
# Keep this equal to the former APP_KEY when rotating audit keys so historical rows remain verifiable.
AUDIT_HMAC_LEGACY_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bts_php_backend
DB_USERNAME=root
DB_PASSWORD=

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Comma-separated exact origins allowed to call the API (never '*' in production).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://127.0.0.1:3003
CORS_ALLOW_LOCAL_DEVELOPMENT=true

OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
# Deliver OTP emails through the queue instead of the HTTP request (requires a running worker).
OTP_QUEUE_DELIVERY=false
# Same story for password-reset emails.
PASSWORD_RESET_QUEUE_DELIVERY=false

# Local-only is the safe default: customer documents never leave this machine.
# Set to openrouter or gemini only after explicit security/privacy approval.
DOCUMENT_VERIFICATION_PROVIDER=local
DOCUMENTS_REQUIRED_FOR_VALIDATION=true
DOCUMENT_AI_MAX_PAYLOAD_BYTES=15728640
DOCUMENT_AI_VALIDATION_BUDGET_SECONDS=20
SECURITY_HSTS_MAX_AGE=31536000
SANCTUM_TOKEN_EXPIRATION=60
# Prefix improves leaked-token detection. Existing tokens remain valid after enabling it.
SANCTUM_TOKEN_PREFIX=bts_
BANKING_TRANSFER_MAX_PER_TRANSFER_MILLIMES=50000000
BANKING_TRANSFER_DAILY_LIMIT_PER_SOURCE_MILLIMES=100000000
BANKING_TRANSFER_LIMIT_TIMEZONE=Africa/Tunis

# OpenRouter/MiniMax adapter — disabled by the provider value above.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE="BTS Bank Development"
OPENROUTER_CONNECT_TIMEOUT_SECONDS=5
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=1
OPENROUTER_RETRY_DELAY_MS=500
OPENROUTER_MAX_OUTPUT_TOKENS=768
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_REASONING_ENABLED=false
# Free PDF parser. Do not switch to mistral-ocr unless paid OCR is intentionally approved.
OPENROUTER_PDF_ENGINE=cloudflare-ai

# Legacy Gemini rollback adapter — disabled by the provider value above.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Transport resilience knobs (defaults shown).
GEMINI_CONNECT_TIMEOUT_SECONDS=5
GEMINI_TIMEOUT_SECONDS=25
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_DELAY_MS=250
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_TEMPERATURE=0.1
GEMINI_THINKING_BUDGET=0

SMS_PROVIDER=email
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_BRAND_NAME=BTSBank

GOOGLE_OAUTH_CLIENT_ID=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Credit-application documents: 'local' (storage/app/documents) in development,
# 's3' in production — downloads always stream through the API either way.
DOCUMENTS_DISK=local
QUEUE_CONNECTION=database
QUEUE_HEALTH_MAX_PENDING=10000
QUEUE_HEALTH_MAX_AGE_SECONDS=300
QUEUE_HEALTH_MAX_FAILED=0
OUTBOX_HEALTH_MAX_PENDING=10000
OUTBOX_HEALTH_MAX_AGE_SECONDS=300
OUTBOX_HEALTH_MAX_FAILED=0
OUTBOX_PROCESSING_TIMEOUT_SECONDS=120
QUEUE_WORKER_HEALTH_REQUIRED=true
QUEUE_WORKER_HEARTBEAT_MAX_AGE=120
SCHEDULER_HEALTH_REQUIRED=false
SCHEDULER_HEARTBEAT_MAX_AGE=120
STORAGE_HEALTH_MIN_FREE_BYTES=1073741824

# Bounded aggregate analytics; exports contain aggregate rows only.
ANALYTICS_DEFAULT_DAYS=365
ANALYTICS_MAX_DAYS=730
ANALYTICS_EXPORT_MAX_ROWS=2500

# Isolated Phase 5 runner only. Never enable against a normal or production database.
BTS_LOAD_TEST_ENABLED=false
BTS_LOAD_TEST_MAX_ACCOUNTS=500
BTS_LOAD_TEST_MAX_CONCURRENCY=100
BTS_LOAD_TEST_MAX_APPLICATIONS_PER_ACCOUNT=3
DOCUMENTS_LOCAL_ROOT=
# Production structured logs: LOG_CHANNEL=stack and LOG_STACK=json. Keep local logs readable.
LOG_JSON_PATH=
DOCUMENT_MALWARE_SCAN=optional
CLAMAV_BINARY=
CLAMAV_TIMEOUT_SECONDS=30
OSQUERY_BINARY_PATH=
OSQUERY_TIMEOUT_SECONDS=10
OSQUERY_MAX_ROWS=200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Optional: endpoint for S3-compatible stores (MinIO, Ceph, Scaleway...).
AWS_ENDPOINT=

# Laravel Reverb (realtime chat). Same values on every app that talks to it:
# the frontends need NEXT_PUBLIC_REVERB_* matching REVERB_*.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
# Optional WebSocket hostnames. Full origins are also accepted and normalized to hostnames.
# When omitted, the hostnames from CORS_ALLOWED_ORIGINS are reused.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"

# Synthetic big-data generator: production remains blocked unless both are set deliberately.
SYNTHETIC_DATA_ALLOW_PRODUCTION=false
SYNTHETIC_DATA_PRODUCTION_TOKEN=
