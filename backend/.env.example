APP_NAME="BTS Bank Credit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bts_php_backend
DB_USERNAME=root
DB_PASSWORD=

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Comma-separated exact origins allowed to call the API (never '*' in production).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
# Deliver OTP emails through the queue instead of the HTTP request (requires a running worker).
OTP_QUEUE_DELIVERY=false
# Same story for password-reset emails.
PASSWORD_RESET_QUEUE_DELIVERY=false

# Gemini — AI document authenticity checks (advisory only, never blocks validation).
# Get a key at https://aistudio.google.com/apikey. Model can be swapped freely (e.g. gemini-2.0-flash).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Transport resilience knobs (defaults shown).
GEMINI_CONNECT_TIMEOUT_SECONDS=10
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_DELAY_MS=1000
GEMINI_MAX_PAYLOAD_BYTES=15728640

SMS_PROVIDER=email
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_BRAND_NAME=BTSBank

GOOGLE_OAUTH_CLIENT_ID=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Credit-application documents: 'local' (storage/app/documents) in development,
# 's3' in production — downloads always stream through the API either way.
DOCUMENTS_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Optional: endpoint for S3-compatible stores (MinIO, Ceph, Scaleway...).
AWS_ENDPOINT=

# Laravel Reverb (realtime chat). Same values on every app that talks to it:
# the frontends need NEXT_PUBLIC_REVERB_* matching REVERB_*.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

VITE_APP_NAME="${APP_NAME}"
